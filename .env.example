# Skopiuj do .env i uzupełnij. Pliku .env nie commituj.

# Konto startowe (admin instancji; hasło: co najmniej 12 znaków).
DENAR_ADMIN_EMAIL=admin@example.com
DENAR_ADMIN_PASSWORD=

# Nazwa instancji na ekranie logowania, do 64 znaków. Puste oznacza „Denar”.
DENAR_INSTANCE_NAME=

# Publiczny adres, pod którym użytkownicy otwierają Denara (sam origin).
# Z niego powstają linki zaproszeń i redirect URI OIDC.
DENAR_BASE_URL=http://localhost:8080
DENAR_PORT=8080
# Adres hosta, na którym port jest publikowany. Zmień na 0.0.0.0 tylko
# w zaufanej sieci; ruch nie jest szyfrowany.
DENAR_BIND=127.0.0.1

# Logowanie OIDC, np. Pocket ID. Komplet trzech wartości je włącza.
# Redirect URI u dostawcy: <DENAR_BASE_URL>/api/auth/callback
DENAR_OIDC_ISSUER=
DENAR_OIDC_CLIENT_ID=
DENAR_OIDC_CLIENT_SECRET=
# true: każdy użytkownik dostawcy dostaje konto przy pierwszym logowaniu.
# false: tylko e-maile z oczekującym zaproszeniem.
DENAR_OIDC_AUTO_CREATE=false

# Sieci CIDR zaufanych reverse proxy (X-Forwarded-For), po przecinku.
DENAR_TRUSTED_PROXIES=

# Limit żądań bota na minutę (10–6000).
DENAR_BOT_RATE=120

# API kursów NBP (tabela A) i co ile uzupełniać kwoty bazowe transakcji
# zapisanych bez kursu (np. offline).
DENAR_NBP_URL=https://api.nbp.pl
DENAR_FX_INTERVAL=30m

# Subskrypcje: na ile dni naprzód generować oczekiwane obciążenia (7–730)
# i co ile uruchamiać joby (obciążenia, przegapione, przypomnienia).
DENAR_CHARGE_HORIZON=90
DENAR_SUBSCRIPTION_INTERVAL=1h
