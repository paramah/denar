# Konfiguracja `task dev:api`. Skopiuj do .env.dev i ustaw hasło; pliku .env.dev nie commituj.

DENAR_BASE_URL=http://localhost:8080
DENAR_ADDR=:8080
DENAR_DB=./.dev/denar.db
DENAR_AUTO_MIGRATE=true
DENAR_INSTANCE_NAME=Denar (dev)

# Konto startowe (hasło: co najmniej 12 znaków).
DENAR_ADMIN_EMAIL=admin@example.com
DENAR_ADMIN_PASSWORD=
